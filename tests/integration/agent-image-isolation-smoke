#!/usr/bin/env bash
set -euo pipefail
root="${VERILOG_EVAL_ROOT:-$(git rev-parse --show-toplevel)}"
for program in nix python3; do command -v "$program" >/dev/null || exit 2; done
scratch="$(mktemp -d "${TMPDIR:-/tmp}/agent-image-isolation.XXXXXX")"
stamp="image-canary-$$-$(date +%s)"
canary_a="$root/.agent-image-canary-$stamp"
canary_b="$root/dataset_spec-to-rtl/.agent-image-hidden-$stamp"
cleanup(){ rm -f "$canary_a" "$canary_b"; rm -rf "$scratch"; }
trap cleanup EXIT INT TERM
printf '%s-root\n' "$stamp" >"$canary_a"
printf '%s-hidden\n' "$stamp" >"$canary_b"

for output in agent-sandbox-image agent-rtl-sandbox-image; do
  link="$scratch/$output"
  nix build "path:$root#$output" --out-link "$link"
  python3 - "$link" "$stamp" <<'PY'
import sys, tarfile, tempfile
from pathlib import Path
archive=Path(sys.argv[1]).resolve(); canary=sys.argv[2].encode()
forbidden=(b"dataset_spec-to-rtl", b"run-config.json", b"_ref.sv", b"_test.sv", b"/.git/")

def checked_copy(stream, destination, label, name):
    overlap=b""
    while True:
        block=stream.read(1024*1024)
        if not block: break
        assert canary not in overlap+block, (label, name)
        overlap=(overlap+block)[-max(0, len(canary)-1):]
        if destination is not None: destination.write(block)

def scan_tar(fileobj, label):
    with tarfile.open(fileobj=fileobj, mode="r:*") as tar:
        for member in tar:
            name=member.name.encode(errors="surrogateescape")
            assert not any(value in name for value in forbidden), (label, member.name)
            normalized = b"/" + name.lstrip(b"./")
            assert not normalized.endswith(
                (b"/bin/npm", b"/bin/npx", b"/bin/corepack")
            ), (label, member.name)
            assert b"/lib/node_modules/npm/" not in normalized, (label, member.name)
            if not member.isfile(): continue
            stream=tar.extractfile(member)
            if stream is None: continue
            nested=member.name.endswith((".tar", ".tar.gz", ".tgz"))
            if nested:
                with tempfile.SpooledTemporaryFile(max_size=16*1024*1024) as target:
                    checked_copy(stream, target, label, member.name)
                    target.seek(0)
                    try: scan_tar(target, f"{label}:{member.name}")
                    except tarfile.ReadError: pass
            else:
                checked_copy(stream, None, label, member.name)

with archive.open("rb") as source:
    scan_tar(source, str(archive))
print(f"image_archive={archive}")
PY
done
echo "agent image isolation passed"
