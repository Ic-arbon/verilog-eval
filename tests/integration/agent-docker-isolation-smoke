#!/usr/bin/env bash
set -euo pipefail

root="${VERILOG_EVAL_ROOT:-$(git rev-parse --show-toplevel)}"
for program in docker nix python3; do
  command -v "$program" >/dev/null || { echo "missing required program: $program" >&2; exit 2; }
done

stamp="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
build_root="${AGENT_EVAL_ISOLATION_RUN_ROOT:-$root/build/agent-isolation-$stamp}"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/agent-isolation.XXXXXX")"
sentinel="$root/dataset_spec-to-rtl/.agent-hidden-sentinel-$stamp"
tools="$scratch/agent-tools"
package="$tools/node_modules/opencode-ai"
problem_file="$scratch/problems.txt"
base_file="$scratch/base-url"
path_file="$scratch/run-path"
before_containers="$scratch/containers-before.txt"
after_containers="$scratch/containers-after.txt"
server_pid=""

cleanup() {
  [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null || true
  rm -f "$sentinel" || true
  chmod -R u+w "$scratch" 2>/dev/null || true
  rm -rf "$scratch" || true
}
trap cleanup EXIT INT TERM

printf 'must-not-enter-agent-container\n' >"$sentinel"
printf 'Prob001_zero\n' >"$problem_file"
mkdir -p "$package" "$build_root"
cat >"$package/opencode" <<'FAKE_AGENT'
#!/usr/bin/env bash
set -euo pipefail
violations=()
mapfile -t hidden_paths < <(
  find / \( -name 'Prob001_zero_ref.sv' -o -name 'Prob001_zero_test.sv' -o -name '.agent-hidden-sentinel-*' \) -print 2>/dev/null || true
)
(( ${#hidden_paths[@]} == 0 )) || violations+=("hidden grader files are visible: ${hidden_paths[*]}")
[[ ! -e /var/run/docker.sock ]] || violations+=("Docker socket is visible")
[[ ! -e /opt/agent/verilog-eval ]] || violations+=("host repository path is visible")
[[ -z "${AGENT_EVAL_SENTINEL_SECRET:-}" ]] || violations+=("unapproved host environment reached the Agent")
if (( ${#violations[@]} > 0 )); then
  printf '%s\n' "${violations[@]}" >&2
  exit 86
fi
cat >TopModule.sv <<'VERILOG'
module TopModule(output zero);
  assign zero = 1'b0;
endmodule
VERILOG
printf '{"type":"tool_use","part":{"state":{"status":"completed"}}}\n'
printf '{"type":"text","part":{"text":"isolation-sentinel-clear"}}\n'
printf '{"type":"step_finish","part":{"tokens":{"input":1,"output":1,"reasoning":0}}}\n'
FAKE_AGENT
chmod 0555 "$package/opencode"
cat >"$tools/package-lock.json" <<'JSON'
{"name":"agent-tools","lockfileVersion":3,"packages":{"":{"dependencies":{"opencode-ai":"1.18.7"}},"node_modules/opencode-ai":{"version":"1.18.7","bin":{"opencode":"opencode"}}}}
JSON

"$root/tests/integration/openai-model-list-server" --write-base-url "$base_file" &
server_pid=$!
for _ in {1..100}; do [[ -s "$base_file" ]] && break; sleep 0.05; done
base_url="$(cat "$base_file")"
: >"$path_file"
chmod 0600 "$path_file"
docker ps -a --format '{{.Names}}' | sort >"$before_containers"

export VERILOG_EVAL_ROOT="$root"
export VERILOG_EVAL_BUILD_ROOT="$build_root"
export VERILOG_EVAL_JOBS=1
export AGENT_EVAL_AGENT_TOOLS="$tools"
export AGENT_EVAL_SENTINEL_SECRET="must-not-enter-agent-container"
export OPENAI_API_KEY="smoke-key"

set +e
nix run "path:$root#agent-eval" -- \
  --with-agent=opencode \
  --with-openai-api-base="$base_url" \
  --with-problems="$problem_file" \
  --with-agent-timeout=60 \
  --with-agent-max-turns=2 \
  --with-agent-thinking=off \
  --with-agent-toolset=standard \
  --run-path-file="$path_file" \
  2>&1 | tee "$build_root/console.log"
status=${PIPESTATUS[0]}
set -e
(( status == 0 )) || { echo "isolation smoke failed at $build_root" >&2; exit "$status"; }
run_dir="$(cat "$path_file")"

docker ps -a --format '{{.Names}}' | sort >"$after_containers"
leftovers="$(comm -13 "$before_containers" "$after_containers" | grep '^verilog-eval-' || true)"
[[ -z "$leftovers" ]] || { echo "new Agent containers remain: $leftovers" >&2; exit 1; }

python3 - "$run_dir" <<'PY'
import hashlib, json, sys
from pathlib import Path
run = Path(sys.argv[1])
manifests = list(run.glob("*/*-generation.json"))
assert len(manifests) == 1, manifests
manifest_path = manifests[0]
manifest = json.loads(manifest_path.read_text())
assert "schema_version" not in manifest
assert manifest["producer"]["run_config_sha256"] == run.name
assert manifest["execution"]["status"] == "completed", manifest
assert manifest["submission"]["status"] == "published", manifest
sample = manifest_path.with_name(manifest_path.name.removesuffix("-generation.json") + ".sv")
assert hashlib.sha256(sample.read_bytes()).hexdigest() == manifest["artifacts"]["candidate"]["sha256"]
trajectory = manifest_path.with_name(manifest_path.name.removesuffix("-generation.json") + "-trajectory.jsonl")
assert "isolation-sentinel-clear" in trajectory.read_text()
report = json.loads((run / "agent-summary.json").read_text())
assert report["correctness"]["passed"] == 1, report
assert report["execution"]["status_counts"] == {"completed": 1}, report
assert report["submission"]["status_counts"] == {"published": 1}, report
assert not (run / "runtime-bindings.json").exists()
assert not (run / ".credential.sock").exists()
print(f"manifest={manifest_path}")
PY
"$root/scripts/validate-agent-run" --expected-samples=1 "$run_dir"
echo "no new Agent containers remain"
echo "isolation artifacts preserved at $run_dir"
