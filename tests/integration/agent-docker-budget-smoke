#!/usr/bin/env bash
set -euo pipefail
root="${VERILOG_EVAL_ROOT:-$(git rev-parse --show-toplevel)}"
for program in docker nix python3; do command -v "$program" >/dev/null || exit 2; done
stamp="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
build_root="${AGENT_EVAL_BUDGET_RUN_ROOT:-$root/build/agent-budget-$stamp}"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/agent-budget.XXXXXX")"
tools="$scratch/agent-tools"; package="$tools/node_modules/@earendil-works/pi-coding-agent"
problem_file="$scratch/problems.txt"; base_file="$scratch/base-url"; path_file="$scratch/run-path"
before="$scratch/before"; after="$scratch/after"; server_pid=""
cleanup(){ [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null || true; chmod -R u+w "$scratch" 2>/dev/null || true; rm -rf "$scratch" || true; }
trap cleanup EXIT INT TERM
printf 'Prob001_zero\n' >"$problem_file"; mkdir -p "$package" "$build_root"
cat >"$package/pi" <<'FAKE_AGENT'
#!/usr/bin/env bash
set -euo pipefail
cat >TopModule.sv <<'VERILOG'
module TopModule(output zero);
  assign zero = 1'b0;
endmodule
VERILOG
cumulative="$(printf 'repeated-output-%.0s' {1..2000})"
printf '{"type":"message_update","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]},"assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"next","partial":{"role":"assistant","content":[{"type":"text","text":"%s"}]}}}\n' "$cumulative" "$cumulative"
for turn in 1 2; do
  printf '{"type":"tool_execution_start","toolName":"write"}\n'
  printf '{"type":"tool_execution_end","toolName":"write","isError":false}\n'
  printf '{"type":"message_end","message":{"role":"assistant","usage":{"input":1,"output":1}}}\n'
  printf '{"type":"turn_end","turn":%s}\n' "$turn"
done
sleep 120
FAKE_AGENT
chmod 0555 "$package/pi"
cat >"$tools/package-lock.json" <<'JSON'
{"name":"agent-tools","lockfileVersion":3,"packages":{"":{"dependencies":{"@earendil-works/pi-coding-agent":"0.82.1"}},"node_modules/@earendil-works/pi-coding-agent":{"version":"0.82.1","bin":{"pi":"pi"}}}}
JSON
"$root/tests/integration/openai-model-list-server" --write-base-url "$base_file" & server_pid=$!
for _ in {1..100}; do [[ -s "$base_file" ]] && break; sleep 0.05; done
base_url="$(cat "$base_file")"; : >"$path_file"; chmod 0600 "$path_file"
docker ps -a --format '{{.Names}}' | sort >"$before"
export VERILOG_EVAL_ROOT="$root" VERILOG_EVAL_BUILD_ROOT="$build_root" VERILOG_EVAL_JOBS=1
export AGENT_EVAL_AGENT_TOOLS="$tools" OPENAI_API_KEY="smoke-key"
set +e
nix run "path:$root#agent-eval" -- \
  --with-agent=pi --with-openai-api-base="$base_url" \
  --with-problems="$problem_file" --with-agent-timeout=60 \
  --with-agent-max-turns=2 --with-agent-max-tool-calls=10 \
  --with-agent-max-input-tokens=16384 --with-agent-thinking=off \
  --with-agent-toolset=standard --run-path-file="$path_file" \
  2>&1 | tee "$build_root/console.log"
status=${PIPESTATUS[0]}; set -e
(( status == 0 )) || { echo "budget smoke failed at $build_root" >&2; exit "$status"; }
run_dir="$(cat "$path_file")"
docker ps -a --format '{{.Names}}' | sort >"$after"
leftovers="$(comm -13 "$before" "$after" | grep '^verilog-eval-' || true)"
[[ -z "$leftovers" ]] || { echo "new Agent containers remain: $leftovers" >&2; exit 1; }
python3 - "$run_dir" <<'PY'
import hashlib, json, sys
from pathlib import Path
run=Path(sys.argv[1]); manifests=list(run.glob("*/*-generation.json")); assert len(manifests)==1
path=manifests[0]; manifest=json.loads(path.read_text())
assert manifest["execution"]["status"]=="error", manifest
assert manifest["execution"]["exit_code"]==86, manifest
assert manifest["execution"]["termination_reason"]=="max_turns", manifest
assert manifest["submission"]["status"]=="published", manifest
assert manifest["limits"]["max_turns"]==2, manifest
assert manifest["usage"]["turns"]==2, manifest
trajectory=path.with_name(path.name.removesuffix("-generation.json")+"-trajectory.jsonl")
events=[json.loads(line) for line in trajectory.read_text().splitlines()]
update=next(event for event in events if event.get("type")=="message_update")
assert "message" not in update and "partial" not in update["assistantMessageEvent"], update
assert trajectory.stat().st_size < 2048
sample=path.with_name(path.name.removesuffix("-generation.json")+".sv")
assert hashlib.sha256(sample.read_bytes()).hexdigest()==manifest["artifacts"]["candidate"]["sha256"]
report=json.loads((run/"agent-summary.json").read_text())
assert report["execution"]["status_counts"]=={"error":1}, report
assert report["submission"]["status_counts"]=={"published":1}, report
print(f"manifest={path}")
PY
"$root/scripts/validate-agent-run" --expected-samples=1 "$run_dir"
echo "no new Agent containers remain"
echo "budget artifacts preserved at $run_dir"
