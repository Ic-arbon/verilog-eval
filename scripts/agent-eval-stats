#!/usr/bin/env python3
"""Summarize Agent execution statuses and canonical VerilogEval results."""

import argparse
import csv
import json
import sys
from collections import Counter
from pathlib import Path
from typing import Dict, Mapping


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Summarize an agent-eval run directory"
    )
    parser.add_argument("run_root", type=Path, help="runs/agent-eval-* directory")
    parser.add_argument(
        "--json",
        action="store_true",
        help="write machine-readable JSON instead of a text report",
    )
    return parser.parse_args()


def parse_bool(value: object) -> bool:
    return str(value).strip().lower() in {"1", "true", "yes"}


def sorted_counts(counter: Counter) -> Dict[str, int]:
    return {str(key): counter[key] for key in sorted(counter)}


def numeric_value(
    row: Mapping[str, str],
    metrics: Mapping[str, object],
    key: str,
    numeric_type,
):
    value = row.get(key)
    if value in {None, ""}:
        value = metrics.get(key, 0)
    return numeric_type(value or 0)


def load_metrics(run_root: Path, row: Mapping[str, str]) -> Mapping[str, object]:
    metrics_path = (
        run_root / row["agent"] / row["problem"] / "metrics.json"
    )
    if not metrics_path.is_file():
        raise FileNotFoundError(f"missing per-problem metrics: {metrics_path}")
    record = json.loads(metrics_path.read_text())
    nested = record.get("metrics")
    if not isinstance(nested, dict):
        nested = {}
    return {"final_sv": record.get("final_sv"), **nested}


def summarize(run_root: Path) -> Dict[str, object]:
    summary_path = run_root / "summary.csv"
    if not summary_path.is_file():
        raise FileNotFoundError(f"missing run summary: {summary_path}")

    with summary_path.open(newline="") as file:
        rows = list(csv.DictReader(file))
    if not rows:
        raise ValueError(f"run summary contains no records: {summary_path}")

    required = {"agent", "problem", "agent_status", "passed"}
    missing = required - set(rows[0])
    if missing:
        raise ValueError(
            "run summary is missing columns: " + ", ".join(sorted(missing))
        )

    status_counts = Counter()
    symbol_counts = Counter()
    passes_by_status = Counter()
    submissions_by_status = Counter()
    passes_by_agent = Counter()
    totals = Counter()
    submitted = 0
    passed = 0

    for row in rows:
        metrics = load_metrics(run_root, row)
        status = row["agent_status"]
        symbol = row.get("verilog_eval_symbol", "") or "(none)"
        is_passed = parse_bool(row["passed"])
        is_submitted = bool(metrics.get("final_sv"))

        status_counts[status] += 1
        symbol_counts[symbol] += 1
        if is_passed:
            passed += 1
            passes_by_status[status] += 1
            passes_by_agent[row["agent"]] += 1
        if is_submitted:
            submitted += 1
            submissions_by_status[status] += 1

        for key in (
            "turns",
            "tool_calls",
            "input_tokens",
            "output_tokens",
            "parse_errors",
        ):
            totals[key] += numeric_value(row, metrics, key, int)
        totals["duration_seconds"] += numeric_value(
            row, metrics, "duration_seconds", float
        )

    total = len(rows)
    metric_totals = {
        "duration_seconds": round(totals["duration_seconds"], 3),
        "turns": totals["turns"],
        "tool_calls": totals["tool_calls"],
        "input_tokens": totals["input_tokens"],
        "output_tokens": totals["output_tokens"],
        "total_tokens": totals["input_tokens"] + totals["output_tokens"],
        "parse_errors": totals["parse_errors"],
    }
    metric_averages = {
        key: round(value / total, 3)
        for key, value in metric_totals.items()
        if key != "parse_errors"
    }

    return {
        "run_root": str(run_root.resolve()),
        "total": total,
        "passed": passed,
        "pass_rate": passed / total,
        "submitted": submitted,
        "submission_rate": submitted / total,
        "conditional_pass_rate": passed / submitted if submitted else 0.0,
        "agent_status": sorted_counts(status_counts),
        "verilog_eval_symbol": sorted_counts(symbol_counts),
        "passes_by_agent_status": sorted_counts(passes_by_status),
        "submissions_by_agent_status": sorted_counts(submissions_by_status),
        "passes_by_agent": sorted_counts(passes_by_agent),
        "metric_totals": metric_totals,
        "metric_averages_per_problem": metric_averages,
    }


def print_counts(title: str, counts: Mapping[str, int]) -> None:
    print(f"{title}:")
    for key, value in counts.items():
        print(f"  {key}: {value}")


def print_text(stats: Mapping[str, object]) -> None:
    print(f"Run: {stats['run_root']}")
    print(
        f"Pass@1: {stats['passed']}/{stats['total']} "
        f"({stats['pass_rate']:.2%})"
    )
    print(
        f"Submitted: {stats['submitted']}/{stats['total']} "
        f"({stats['submission_rate']:.2%})"
    )
    print(
        "Conditional pass rate: "
        f"{stats['passed']}/{stats['submitted']} "
        f"({stats['conditional_pass_rate']:.2%})"
    )
    print_counts("Agent status", stats["agent_status"])
    print_counts("Submissions by agent status", stats["submissions_by_agent_status"])
    print_counts("Passes by agent status", stats["passes_by_agent_status"])
    print_counts("VerilogEval symbols", stats["verilog_eval_symbol"])
    print_counts("Passes by agent", stats["passes_by_agent"])
    print_counts("Metric totals", stats["metric_totals"])
    print_counts("Metric averages per problem", stats["metric_averages_per_problem"])


def main() -> int:
    args = parse_args()
    try:
        stats = summarize(args.run_root)
    except (FileNotFoundError, ValueError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(stats, indent=2, sort_keys=True))
    else:
        print_text(stats)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
