#!/usr/bin/env python3
"""Summarize Generator ABI Agent sidecars with original VerilogEval results."""

import argparse
import csv
import json
import sys
from collections import Counter
from pathlib import Path
from typing import Dict, List, Mapping, Tuple


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Summarize a harness-v2 Agent evaluation run"
    )
    parser.add_argument("run_root", type=Path)
    parser.add_argument("--agent", choices=["pi", "opencode"])
    parser.add_argument("--json", action="store_true")
    return parser.parse_args()


def sorted_counts(values: Counter) -> Dict[str, int]:
    return {str(key): values[key] for key in sorted(values)}


def discover_agent_roots(run_root: Path, selected: str = None) -> List[Path]:
    if (run_root / "summary.csv").is_file():
        roots = [run_root]
    else:
        roots = [
            path
            for path in sorted(run_root.iterdir())
            if path.is_dir() and (path / "summary.csv").is_file()
        ]
    if selected:
        roots = [path for path in roots if path.name == selected]
    if not roots:
        raise FileNotFoundError(f"no Agent summary.csv found under {run_root}")
    return roots


def load_verilog_results(agent_root: Path):
    symbols: Dict[Tuple[str, str], str] = {}
    passed = 0
    samples = 0
    with (agent_root / "summary.csv").open(newline="") as file:
        for row in csv.reader(file):
            if not row:
                continue
            problem = row[0]
            num_passed = int(row[1])
            num_samples = int(row[2])
            row_symbols = row[4:]
            passed += num_passed
            samples += num_samples
            for index, symbol in enumerate(row_symbols, start=1):
                symbols[(problem, f"sample{index:02d}")] = symbol
    return passed, samples, symbols


def load_sidecars(agent_root: Path):
    records = []
    for path in sorted(agent_root.glob("Prob*/sample*/agent.json")):
        record = json.loads(path.read_text())
        record["_sample_dir"] = path.parent.name
        records.append(record)
    if not records:
        raise FileNotFoundError(f"no generator agent.json sidecars under {agent_root}")
    return records


def summarize_agent(agent_root: Path) -> Dict[str, object]:
    passed, total, symbols = load_verilog_results(agent_root)
    records = load_sidecars(agent_root)

    status_counts = Counter()
    submission_counts = Counter()
    passes_by_status = Counter()
    symbol_counts = Counter(symbols.values())
    totals = Counter()
    submitted = 0

    for record in records:
        status = record["status"]
        is_submitted = bool(record["submitted"])
        symbol = symbols.get(
            (record["problem"], record["_sample_dir"]), "(missing-result)"
        )
        status_counts[status] += 1
        if is_submitted:
            submitted += 1
            submission_counts[status] += 1
        if symbol == ".":
            passes_by_status[status] += 1

        metrics = record.get("metrics", {})
        totals["duration_seconds"] += float(record.get("duration_seconds", 0) or 0)
        for key in (
            "turns",
            "tool_calls",
            "input_tokens",
            "output_tokens",
            "parse_errors",
        ):
            totals[key] += int(metrics.get(key, 0) or 0)

    metric_totals = {
        "duration_seconds": round(totals["duration_seconds"], 3),
        "turns": totals["turns"],
        "tool_calls": totals["tool_calls"],
        "input_tokens": totals["input_tokens"],
        "output_tokens": totals["output_tokens"],
        "total_tokens": totals["input_tokens"] + totals["output_tokens"],
        "parse_errors": totals["parse_errors"],
    }
    denominator = len(records)
    metric_averages = {
        key: round(value / denominator, 3)
        for key, value in metric_totals.items()
        if key != "parse_errors"
    }

    return {
        "total": total,
        "sidecars": len(records),
        "passed": passed,
        "pass_rate": passed / total if total else 0.0,
        "submitted": submitted,
        "submission_rate": submitted / total if total else 0.0,
        "conditional_pass_rate": passed / submitted if submitted else 0.0,
        "agent_status": sorted_counts(status_counts),
        "submissions_by_agent_status": sorted_counts(submission_counts),
        "passes_by_agent_status": sorted_counts(passes_by_status),
        "verilog_eval_symbol": sorted_counts(symbol_counts),
        "metric_totals": metric_totals,
        "metric_averages_per_sample": metric_averages,
    }


def build_report(run_root: Path, selected: str = None) -> Dict[str, object]:
    roots = discover_agent_roots(run_root, selected)
    return {
        "run_root": str(run_root.resolve()),
        "agents": {root.name: summarize_agent(root) for root in roots},
    }


def print_counts(title: str, values: Mapping[str, object]) -> None:
    print(f"{title}:")
    for key, value in values.items():
        print(f"  {key}: {value}")


def print_text(report: Mapping[str, object]) -> None:
    print(f"Run: {report['run_root']}")
    for agent, stats in report["agents"].items():
        print(f"\nAgent: {agent}")
        print(
            f"Pass@1: {stats['passed']}/{stats['total']} "
            f"({stats['pass_rate']:.2%})"
        )
        print(
            f"Submitted: {stats['submitted']}/{stats['total']} "
            f"({stats['submission_rate']:.2%})"
        )
        conditional = (
            f"{stats['conditional_pass_rate']:.2%}"
            if stats["submitted"]
            else "N/A"
        )
        print(
            f"Conditional pass rate: {stats['passed']}/{stats['submitted']} "
            f"({conditional})"
        )
        print(f"Sidecars: {stats['sidecars']}/{stats['total']}")
        print_counts("Agent status", stats["agent_status"])
        print_counts(
            "Submissions by agent status", stats["submissions_by_agent_status"]
        )
        print_counts("Passes by agent status", stats["passes_by_agent_status"])
        print_counts("VerilogEval symbols", stats["verilog_eval_symbol"])
        print_counts("Metric totals", stats["metric_totals"])
        print_counts(
            "Metric averages per sample", stats["metric_averages_per_sample"]
        )


def main() -> int:
    args = parse_args()
    try:
        report = build_report(args.run_root.resolve(), args.agent)
    except (FileNotFoundError, ValueError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text(report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
