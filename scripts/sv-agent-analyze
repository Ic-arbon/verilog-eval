#!/usr/bin/env python3
"""Create an Agent report from canonical VerilogEval grading output."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from agent_generation.report import (  # noqa: E402
    ReportError,
    build_agent_report,
    write_agent_report,
)


def parse_args(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--summary-csv", type=Path, required=True)
    parser.add_argument("--output-json", type=Path, required=True)
    parser.add_argument("--output-text", type=Path, required=True)
    return parser, parser.parse_args(argv)


def main(argv=None) -> int:
    parser, args = parse_args(argv)
    try:
        report = build_agent_report(args.summary_csv)
        write_agent_report(
            report,
            json_path=args.output_json,
            text_path=args.output_text,
        )
    except ReportError as error:
        parser.exit(2, f"ERROR: {error}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
