#!/usr/bin/env python3
"""Create an Agent report from canonical VerilogEval grading output."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from agent_generation.report import (  # noqa: E402
    ReportError,
    ReportTransactionError,
    build_agent_report,
    write_agent_report,
)
from agent_generation.run_config import RunConfigError, load_run_config  # noqa: E402


def parse_args(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--run-config", type=Path, required=True)
    parser.add_argument("--summary-csv", type=Path, required=True)
    parser.add_argument("--output-json", type=Path, required=True)
    parser.add_argument("--output-text", type=Path, required=True)
    return parser, parser.parse_args(argv)


def main(argv=None) -> int:
    parser, args = parse_args(argv)
    try:
        config_path = args.run_config.resolve(strict=True)
        config = load_run_config(config_path)
        digest = config_path.parent.name
        report = build_agent_report(
            args.summary_csv,
            run_config_sha256=digest,
            expected_problems=config["benchmark"]["problems"],
            expected_samples_per_problem=config["benchmark"]["samples"],
        )
        write_agent_report(
            report,
            summary_csv=args.summary_csv,
            run_config_sha256=digest,
            json_path=args.output_json,
            text_path=args.output_text,
        )
    except (ReportError, ReportTransactionError, RunConfigError, OSError) as error:
        parser.exit(2, f"ERROR: {error}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
