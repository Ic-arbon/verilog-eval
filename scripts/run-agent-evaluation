#!/usr/bin/env python3
"""Repository entrypoint for content-addressed Agent evaluation runs."""

from __future__ import annotations

import sys
from pathlib import Path

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[1]
